# syntax=docker/dockerfile:1
FROM alpine:3.20

# Prove that both build-time secrets are available, without logging or copying
# either into an image layer.
RUN --mount=type=secret,id=test_build_secret_1 \
    --mount=type=secret,id=test_build_secret_2 \
    test -s /run/secrets/test_build_secret_1 && \
    test -s /run/secrets/test_build_secret_2 && \
    echo "Build-time secrets mounted"

CMD ["sh", "-c", "echo 'Container started from secret-test image' && sleep 10"]
