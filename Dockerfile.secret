# syntax=docker/dockerfile:1
FROM alpine:3.20

# Prove that both build-time secrets are available, without logging or copying
# either into an image layer. The secret IDs match the inherited secret names.
RUN --mount=type=secret,id=TEST_BUILD_SECRET1 \
    --mount=type=secret,id=TEST_BUILD_SECRET2 \
    test -s /run/secrets/TEST_BUILD_SECRET1 && \
    test -s /run/secrets/TEST_BUILD_SECRET2 && \
    echo "Build-time secrets mounted"

CMD ["sh", "-c", "echo 'Container started from secret-test image' && sleep 10"]
